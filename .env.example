# ------------------------------------------------------------
# AI Multi-Agent Office – environment configuration
# Copy to `.env` (repo root) and adjust. All values are optional.
# ------------------------------------------------------------

# HTTP server
MAO_HOST=127.0.0.1
MAO_PORT=4317

# Where the SQLite database, uploaded files, agent workspaces and backups live.
# Relative paths are resolved from the server/ directory.
MAO_DATA_DIR=./data

# 32-byte master key used for AES-256-GCM encryption of provider credentials.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty, a key is generated on first start and stored in <MAO_DATA_DIR>/master.key
# (keep that file secret and back it up – without it stored credentials cannot be decrypted).
MAO_MASTER_KEY=

# Login session lifetime (hours)
MAO_SESSION_TTL_HOURS=168

# Maximum upload size per file (MB)
MAO_MAX_UPLOAD_MB=200

# Optional: allow a separate frontend origin (only needed if you do NOT use the Vite proxy / built web app)
MAO_CORS_ORIGIN=

# Optional: path to ffmpeg (used for video analysis: audio track + key frames). Defaults to "ffmpeg" on PATH.
MAO_FFMPEG_PATH=

# Optional: global API rate limit (requests per minute per IP)
MAO_RATE_LIMIT_PER_MIN=600
